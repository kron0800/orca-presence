# orca-presence environment configuration
# Copy this file to `.env` and fill in your values. The daemon reads these
# into the environment before resolving the configuration (`.env` is gitignored;
# this example file is the committed template).
#
# Precedence: real environment variables > `.env` > TOML (`orca-presence.toml`)
# > documented defaults. The daemon refuses to start if no client_id is set.

# REQUIRED. The Application ID of the Discord application you own.
# Create it at https://discord.com/developers/applications and copy the
# "Application ID" from the General Information tab.
ORCA_DISCORD_CLIENT_ID=

# Optional. Seconds between Orca CLI polls; also the Discord publish throttle
# interval. Default: 15.0
#ORCA_PRESENCE_POLL_INTERVAL_SECONDS=15.0

# Optional. The Orca CLI command or path. A bare command name is resolved
# through PATH; a leading `~` is expanded. Default: orca
#ORCA_PRESENCE_ORCA_EXECUTABLE=orca

# Optional. Seconds per Orca CLI invocation before it times out.
# Default: 5.0
#ORCA_PRESENCE_ORCA_TIMEOUT_SECONDS=5.0

# Optional. Enable the OpenCode token/cost part of the Discord state. While
# disabled (the default) the usage database is never read.
# Default: false
#ORCA_PRESENCE_SHOW_USAGE=false

# Optional. Append the estimated USD cost to the usage part of the state.
# Only meaningful together with ORCA_PRESENCE_SHOW_USAGE. Default: false
#ORCA_PRESENCE_SHOW_COST=false

# Optional. Seconds between OpenCode usage database reads; independent from
# the Orca poll interval. Default: 300.0
#ORCA_PRESENCE_USAGE_INTERVAL_SECONDS=300.0

# Optional. Path to the local OpenCode database, read in read-only mode.
# A leading `~` is expanded. Default: ~/.local/share/opencode/opencode.db
#ORCA_PRESENCE_USAGE_DB_PATH=~/.local/share/opencode/opencode.db

# Optional. IANA time zone used only to render times for presentation.
# Default: America/Argentina/Cordoba
#ORCA_PRESENCE_TIMEZONE=America/Argentina/Cordoba

# Optional. Path to an existing TOML config file. When unset the daemon looks
# for `orca-presence.toml` in the current working directory.
#ORCA_PRESENCE_CONFIG_FILE=